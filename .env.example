# Google AI Studio API Key (for translations)
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here

# Session Secrets (IMPORTANT: Generate unique secrets for production!)
# Generate with: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=<your_session_secret_here>
CSRF_SECRET=<your_csrf_secret_here>

